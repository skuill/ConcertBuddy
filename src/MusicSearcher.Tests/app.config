<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- Keys are never committed. For a manual run of the tests against the real services, fill them locally
	     and do not commit the file; #44 moves the keys out of this file. -->
	<appSettings>
		<add key="LastFmApiKey" value=""/>
		<add key="LastFmApiSecret" value=""/>
		<add key="SpotifyClientID" value=""/>
		<add key="SpotifyClientSecret" value=""/>
		<add key="YandexToken" value=""/>
	</appSettings>
</configuration>